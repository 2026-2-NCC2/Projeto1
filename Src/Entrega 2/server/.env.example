# Copie este arquivo para ".env" (na pasta server) e preencha com os seus valores.
# O ".env" NAO vai para o Git (esta no .gitignore). Nunca coloque senhas neste exemplo.

# Banco (Supabase/Postgres). No Supabase: Project Settings > Database > Connection string > URI
# formato: postgresql://postgres:[SUA-SENHA]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:SUA-SENHA@HOST:5432/postgres

# Chave que assina o login (JWT). Use um texto longo e aleatorio, diferente para cada pessoa/ambiente.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# E-mail que envia as mensagens do sistema (Gmail com senha de app). Usado em config/mailer.js.
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
