# Copie este arquivo para ".env" (na pasta server) e preencha com os seus valores.
# O ".env" NAO vai para o Git (esta no .gitignore). Nunca coloque senhas neste exemplo.

# Banco (Supabase/Postgres). No Supabase: Project Settings > Database > Connection string > URI
# Local:  postgresql://postgres:[SUA-SENHA]@db.[REF].supabase.co:5432/postgres
# Vercel: use o pooler (porta 6543), veja o comentario em config/db.js
DATABASE_URL=postgresql://postgres:SUA-SENHA@HOST:5432/postgres

# Chave que assina o login (JWT). Use um texto longo e aleatorio, diferente para cada pessoa/ambiente.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Confirmacao de e-mail: a conta so e criada depois do clique no link enviado por e-mail.
# Endereco do front-end, usado para montar o link do e-mail. Local: http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Chave da API do Resend (https://resend.com). Sem ela, em desenvolvimento o link aparece no
# terminal do servidor; em producao (NODE_ENV=production) o e-mail NAO e enviado.
# RESEND_API_KEY=re_xxxxxxxx
# Remetente. Com o dominio verificado no Resend: TrocaTicket <nao-responda@seudominio.com>.
# Sem dominio, o padrao (onboarding@resend.dev) so entrega para o e-mail dono da conta Resend.
# EMAIL_FROM=TrocaTicket <onboarding@resend.dev>

# Opcional. Origens que podem chamar a API, separadas por virgula (veja app.js).
# CORS_ORIGIN=http://localhost:5173
